{
  "manifest_version": 2,
  "name": "MCAS Proxy Bypass",
  "version": "1.0.0",
  "description": "Intercepts Microsoft MCAS proxy redirects and sends you directly to the original URL instead.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_action": {
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    },
    "default_title": "MCAS Proxy Bypass",
    "default_popup": "popup.html"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "cookies",
    "*://mcas-proxyweb.mcas.ms/*",
    "*://*.mcas.ms/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mcas-remover@posteo.de",
      "strict_min_version": "91.0"
    }
  }
}
